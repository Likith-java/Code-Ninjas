# PostgreSQL connection string (supports psycopg v3 or psycopg2)
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/everest_textile

# Allowed CORS Origins for React/Next.js frontend integration
# Specify single origin or comma-separated list
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
