# PostgreSQL connection string (supports psycopg v3 or psycopg2)
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/everest_textile

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_MIN=720

# Allowed CORS Origins for React/Next.js frontend integration
# Specify single origin or comma-separated list
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============================================================
# Automated Email Notifications (SMTP Configuration)
# ============================================================
# To test with Gmail SMTP:
# 1. Enable 2-Factor Authentication on your Google Account
# 2. Generate an App Password under Security -> App Passwords
# 3. Set SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USERNAME=your.email@gmail.com, SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
#
# If SMTP_HOST is left empty, the application skips real email delivery without errors.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-secure-app-password
SMTP_FROM_EMAIL=notifications@everesttextiles.com
SMTP_FROM_NAME=Everest Textile Mills
SMTP_USE_TLS=true
SMTP_USE_SSL=false
EMAIL_TEST_MODE=false
